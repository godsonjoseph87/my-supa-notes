# Google Identity Services OAuth 2.0 Web Client ID
# Create in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure http://localhost:3000 is added to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Google Gemini API Key
# Create free in Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
